{
  "manifest_version": 3,
  "name": "Authenticator Companion",
  "version": "0.1.0",
  "description": "Store approved authenticator accounts locally in the browser.",
  "permissions": ["storage", "clipboardWrite", "clipboardRead"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Authenticator Companion",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "authenticator-companion@authcore.dev",
      "strict_min_version": "128.0"
    }
  }
}
