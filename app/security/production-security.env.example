# Android release builds require these values.
# Use one DNS hostname. Do not include https:// or a path.
AUTHCORE_PINNED_HOST=sync.example.com

# Current and backup SHA-256 SPKI pins. Separate the two base64 values with a comma.
AUTHCORE_SPKI_PINS=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=,BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
